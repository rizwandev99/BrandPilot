# BrandPilot Environment Variables Manifest
# Copy this file to .env.local for local development.
# Never commit real secrets to source control.

# Database (Neon Postgres)
# Pooled connection string used for web requests and serverless lambdas
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/brandpilot?sslmode=require

# Direct unpooled connection string used for schema migrations
DATABASE_URL_UNPOOLED=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/brandpilot?sslmode=require

# Google Gemini API (Optional — FallbackProvider operates 100% offline if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Daily LLM Budget Guardrail (Caps daily Gemini calls before fallback triggers)
LLM_DAILY_BUDGET=100

# Encryption Key for AES-256-GCM (32-byte key in hex format)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Cron Endpoint Authentication Secret (Bearer token required for /api/publish/run-due)
CRON_SECRET=super_secret_cron_token_change_me

# Anonymous Workspace TTL (Days before inactive workspaces and cascaded data are deleted)
WORKSPACE_TTL_DAYS=7

# LinkedIn Live Publishing Feature Guard (Default false: sandbox mode active)
ENABLE_LIVE_LINKEDIN=false

# LinkedIn OAuth App Credentials (Required only when ENABLE_LIVE_LINKEDIN=true)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/connectors/linkedin/callback

# Public Base URL
APP_URL=http://localhost:3000
